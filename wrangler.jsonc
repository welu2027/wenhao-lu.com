{
  "name": "wenhao-lu-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // ESPN_S2 and ESPN_SWID are secrets, set in the Cloudflare dashboard
  "vars": {
    "ESPN_LEAGUE": "2073338009",
    "ESPN_TEAM": "6",
    "ESPN_SEASON": "2027"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
