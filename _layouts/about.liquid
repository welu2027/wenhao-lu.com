---
layout: redesign_default
---
<div class="fade-in">

  <!-- Hero -->
  <header class="hero">
    <div class="hero-photo">
      <img src="{{ '/assets/img/selfie.jpg' | relative_url }}" alt="Wenhao Lu">
    </div>
    <div class="hero-info">
      <div class="hero-role">
        <span class="dot"></span>
        AI SAFETY RESEARCHER

      </div>
      <h1 class="hero-name">
        <span class="last">Wenhao</span>
        <span class="accent">Lu</span>
      </h1>
    </div>
  </header>

  <!-- Meta strip -->
  <div class="meta-strip">
    <div class="meta-item">
      <span class="meta-key"><i class="fa-solid fa-location-dot"></i></span>
      <span>Millburn, NJ</span>
    </div>
    <div class="meta-item">
      <span class="meta-key"><i class="fa-solid fa-envelope"></i></span>
      <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
    </div>
    <div class="meta-item">
      <span class="meta-key"><i class="ai ai-google-scholar"></i></span>
      <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" target="_blank" rel="noopener">google scholar</a>
    </div>
    <div class="meta-item">
      <span class="meta-key"><i class="fa-brands fa-github"></i></span>
      <a href="https://github.com/{{ site.data.socials.github_username }}" target="_blank" rel="noopener">{{ site.data.socials.github_username }}</a>
    </div>
    <div class="meta-item">
      <span class="meta-key"><i class="fa-brands fa-linkedin"></i></span>
      <a href="https://linkedin.com/in/{{ site.data.socials.linkedin_username }}" target="_blank" rel="noopener">{{ site.data.socials.linkedin_username }}</a>
    </div>
  </div>

  <!-- § 01 About -->
  <section>
    <div class="section-head">
      <span class="section-num">§ 01</span>
      <h2 class="section-title">about</h2>
      <div class="section-rule"></div>
    </div>
    <div class="prose">
      {{ content }}
    </div>
    <div class="tag-row">
      <span class="tag">ai-safety</span>
      <span class="tag">interpretability</span>
      <span class="tag">llm-alignment</span>
      <span class="tag">ai4math</span>
      <span class="tag">spectral-graph-theory</span>
    </div>
    <div class="affil-strip">
      <span class="affil-label">conducted research at</span>
      <div class="affil-logos">
        <img src="{{ '/assets/img/stealth.png' | relative_url }}" alt="Stealth AI Venture">
        <img src="{{ '/assets/img/colleges/stanford.png' | relative_url }}" alt="Stanford">
        <img src="{{ '/assets/img/colleges/mitcsail.png' | relative_url }}" alt="MIT CSAIL">
        <img src="{{ '/assets/img/colleges/nyu.jpg' | relative_url }}" alt="NYU">
        <img src="{{ '/assets/img/colleges/wellesley.svg' | relative_url }}" alt="Wellesley">
        <img src="{{ '/assets/img/colleges/stevens.png' | relative_url }}" alt="Stevens">
      </div>
    </div>
  </section>

  <!-- § 02 Now -->
  <section>
    <div class="section-head">
      <span class="section-num">§ 02</span>
      <h2 class="section-title">now</h2>
      <div class="section-rule"></div>
    </div>
    <div class="now-grid">
      <a class="now-card" href="https://nxthorizon.org" target="_blank" rel="noopener">
        <span class="now-arrow">↗</span>
        <div class="now-kicker">BUILDING</div>
        <div class="now-title">NXT Horizon</div>
        <div class="now-desc">AI talent accelerator for underrepresented students, spanning 50+ countries and 1.2K+ in career pipeline.</div>
        <div class="now-stats">
          <span>50+ countries</span>
          <span>1.2K+ pipeline</span>
          <span>$17K+ raised</span>
        </div>
      </a>
      <div class="now-card now-card-img">
        <img src="{{ '/assets/img/nxt.png' | relative_url }}" alt="NXT Horizon">
      </div>
    </div>
    <div class="now-card" style="margin-top:12px;">
      <div class="now-kicker">RESEARCH ENGINEER</div>
      <div class="now-title">Stealth AI Venture</div>
      <div class="now-desc">The only high schooler among the first research engineers — alongside ex-Microsoft, ex-Google, and ex-DeepMind engineers and PhDs from Stanford, MIT, and CMU.</div>
      <img src="{{ '/assets/img/stealthdescription.png' | relative_url }}" alt="Stealth AI Venture" style="width:100%;border-radius:4px;margin-top:12px;display:block;">
    </div>
  </section>

  <!-- § 03 Dig deeper -->
  <section>
    <div class="section-head">
      <span class="section-num">§ 03</span>
      <h2 class="section-title">dig deeper</h2>
      <div class="section-rule"></div>
    </div>
    <div class="preview-grid">
      <a class="preview-card" href="{{ '/publications/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">RESEARCH</div>
        <div class="pv-title">Publications</div>
        <div class="pv-desc">Papers in <em>Diabetes</em>, IEEE Xplore, and more. Under review at ICML and NeurIPS.</div>
      </a>
      <a class="preview-card" href="{{ '/projects/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">BUILD</div>
        <div class="pv-title">Projects</div>
        <div class="pv-desc">Research, web dev, and fun.</div>
      </a>
      <a class="preview-card" href="{{ '/cv/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">BACKGROUND</div>
        <div class="pv-title">CV</div>
        <div class="pv-desc">Education, experience, awards.</div>
      </a>
      <a class="preview-card" href="{{ '/blog/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">WRITING</div>
        <div class="pv-title">Blog</div>
        <div class="pv-desc">Essays, ideas, and research notes.</div>
      </a>
      <a class="preview-card" href="{{ '/reading/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">SHELF</div>
        <div class="pv-title">Reading</div>
        <div class="pv-desc">Books, podcasts, and things worth your time.</div>
      </a>
      <a class="preview-card" href="{{ '/contact/' | relative_url }}">
        <span class="pv-arrow">→</span>
        <div class="pv-key">CONNECT</div>
        <div class="pv-title">Contact</div>
        <div class="pv-desc">Best ways to reach me.</div>
      </a>
    </div>
  </section>

</div>
