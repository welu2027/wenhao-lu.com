---
layout: redesign_default
---
<div class="fade-in ink-page-body">
  <!-- Ink-landscape hero -->
  {%- comment -%}
    ink_name  = vertical name of the site owner. Given name 文灏 (wén hào).
    Prepend your surname character once confirmed, e.g. 陆文灏 / 卢文灏.
  {%- endcomment -%}
  {% assign ink_name = '文灏' %}
  <header class="ink-hero">
    <h1 class="ink-name">{{ ink_name }}</h1>

    <div class="ink-profile">
      <img class="ink-photo" src="{{ '/assets/img/selfie.jpg' | relative_url }}" alt="Wenhao Lu" />
      <div class="ink-lanterns" aria-label="find me elsewhere">
        <a
          class="lantern"
          href="https://mail.google.com/mail/?view=cm&fs=1&to={{ site.data.socials.email }}"
          target="_blank"
          rel="noopener"
          title="email"
          aria-label="email"
          ><span class="globe"><i class="fa-solid fa-envelope"></i></span
        ></a>
        <a
          class="lantern"
          href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
          target="_blank"
          rel="noopener"
          title="google scholar"
          aria-label="google scholar"
          ><span class="globe"><i class="ai ai-google-scholar"></i></span
        ></a>
        <a class="lantern" href="https://orcid.org/{{ site.data.socials.orcid_id }}" target="_blank" rel="noopener" title="orcid" aria-label="orcid"
          ><span class="globe"><i class="ai ai-orcid"></i></span
        ></a>
        <a
          class="lantern"
          href="https://github.com/{{ site.data.socials.github_username }}"
          target="_blank"
          rel="noopener"
          title="github"
          aria-label="github"
          ><span class="globe"><i class="fa-brands fa-github"></i></span
        ></a>
        <a
          class="lantern"
          href="https://linkedin.com/in/{{ site.data.socials.linkedin_username }}"
          target="_blank"
          rel="noopener"
          title="linkedin"
          aria-label="linkedin"
          ><span class="globe"><i class="fa-brands fa-linkedin"></i></span
        ></a>
      </div>
    </div>

    <div class="ink-intro">
      <span class="block">
        <p>
          hi! i’m wenhao, a 17 year old working to make ai human-centered. i do this in two ways: ai safety research, and
          spreading ai literacy to under-resourced communities. i also enjoy exploring neurosymbolic reasoning through math and poetry.
        </p>
      </span>
    </div>

    <section class="ink-highlights" aria-label="highlights">
      <h2 class="ink-hl-title">highlights</h2>
      <div class="hl-grid">
        <div class="hl-group">
          <h3 class="hl-label">olympiads</h3>
          <ul>
            <li>
              <a href="https://maa.org/wp-content/uploads/2026/02/2025-USAJMO-Awards-Winner-List.pdf" target="_blank" rel="noopener"
                >USA Junior Math Olympiad, honorable mention</a
              >
            </li>
            <li><a href="https://usaco.org/" target="_blank" rel="noopener">USA Computing Olympiad, platinum division</a></li>
          </ul>
        </div>
        <div class="hl-group">
          <h3 class="hl-label">poetry</h3>
          <ul>
            <li>
              <a href="https://www.artandwriting.org/national-student-poets-program/" target="_blank" rel="noopener"
                >National Student Poets Program semi-finalist</a
              >
              <span class="hl-note">(50/36,000 in Scholastic poetry)</span>
            </li>
            <li>
              <a href="https://www.artandwriting.org/" target="_blank" rel="noopener">Scholastic national silver medal</a>
              <span class="hl-note">(2500/330,000 submissions)</span>
            </li>
          </ul>
        </div>
        <div class="hl-group">
          <h3 class="hl-label">research</h3>
          <ul>
            <li><a href="https://arxiv.org/abs/2610.14099" target="_blank" rel="noopener">closed 26-year open problem in discrete geometry (JMM '27)</a></li>
            <li>received research grant from Google DeepMind</li>
            <li>presented research at IEEE, ADA, ICML, JMM</li>
            <li><a href="https://www.non-trivial.org/" target="_blank" rel="noopener">Non-Trivial research finalist</a></li>
          </ul>
        </div>
        <div class="hl-group">
          <h3 class="hl-label">building</h3>
          <ul>
            <li>
              <a href="https://nxthorizon.org" target="_blank" rel="noopener">NXT Horizon</a>: founded an AI incubator for underrepresented students
              <ul class="hl-sub">
                <li>lead 60 staff and 128 chapters</li>
                <li>4700 participants from 137 countries</li>
                <li>raised $55k from 24 sponsors</li>
                <li>mentored 15 students to NeurIPS (2x Creative AI, 5x workshops)</li>
                <li>
                  <a href="https://yimo-official.org/" target="_blank" rel="noopener">YIMO</a>: founded global math competition, 2600+ registered
                  competitors
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
      <a class="hl-more" href="{{ '/cv/' | relative_url }}">full cv &rarr;</a>
    </section>
  </header>
</div>
