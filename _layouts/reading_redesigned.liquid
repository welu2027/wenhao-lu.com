---
layout: redesign_default
---
<div class="page-anim">

  <!-- Page header -->
  <div class="page-header">
    <div>
      <h1 class="page-title">gallery</h1>
    </div>
    <div class="page-aside">
      <div class="crumb"><a href="{{ '/' | relative_url }}">← back home</a></div>
    </div>
  </div>


  <div class="section-head">
    <h2 class="section-title">shelf</h2>
    <div class="section-rule"></div>
  </div>

  {% if site.data.watching %}
  <div class="shelf-grid">
    {% for item in site.data.watching %}
    <figure class="shelf-item">
      {% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener">{% endif %}
      <img src="{{ item.image | relative_url }}" alt="{{ item.title }}" loading="lazy">
      {% if item.url %}</a>{% endif %}
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  <hr class="section-sep" />

  <div class="section-head">
    <h2 class="section-title">works</h2>
    <div class="section-rule"></div>
  </div>

  {% if site.data.mywork %}
  <div class="shelf-grid">
    {% for item in site.data.mywork %}
    <figure class="shelf-item shelf-item-work">
      {% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener">{% endif %}
      <img src="{{ item.image | relative_url }}" alt="{{ item.title }}" loading="lazy">
      {% if item.url %}</a>{% endif %}
      <figcaption>
        {% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
        {% if item.note %}<span class="shelf-note">{{ item.note }}</span>{% endif %}
      </figcaption>
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  <!-- Listening -->
  {% if site.data.listening %}
  <div class="cv-section">
    <h3>Listening</h3>
    {% for item in site.data.listening %}
    <div class="cv-entry">
      <div class="cv-when" style="text-transform:uppercase;font-size:11px;letter-spacing:0.6px;">{{ item.type | default: 'podcast' }}</div>
      <div>
        <div class="cv-where" style="font-size:17px;">
          {% if item.url %}<a href="{{ item.url }}" target="_blank" rel="noopener" style="text-decoration:none;color:inherit;">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
        </div>
        {% if item.creator %}<div class="cv-role">{{ item.creator }}</div>{% endif %}
        {% if item.note %}<div style="font-size:13.5px;color:var(--muted);">{{ item.note }}</div>{% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

</div>
