    {% include head.liquid %}
  </head>
  <body class="{% if page.permalink == '/' %}home{% else %}page-reading{% endif %}">
    <div class="ink-bg" aria-hidden="true"></div>
    <div class="shell">
      {% include minimal_header.liquid %}
      {{ content }}
      {% include minimal_footer.liquid %}
    </div>
    {% include scripts.liquid %}
  </body>
</html>
