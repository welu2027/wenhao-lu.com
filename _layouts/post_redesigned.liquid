---
layout: redesign_default
---
<div class="page-anim">

  <!-- Page header -->
  <div class="page-header">
    <div>
      <span class="page-kicker">{{ page.date | date: '%b %d, %Y' }}</span>
      <h1 class="page-title">{{ page.title }}</h1>
      {% if page.description %}<p class="page-subtitle">{{ page.description }}</p>{% endif %}
    </div>
    <div class="page-aside">
      <div class="crumb"><a href="{{ '/blog/' | relative_url }}">← back to blog</a></div>
    </div>
  </div>

  <article class="post-body">
    {{ content }}
  </article>

</div>
