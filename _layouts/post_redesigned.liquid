---
layout: redesign_default
---
<div class="page-anim">

  <!-- Compact hero -->
  <header class="hero hero-compact">
    <div class="hero-photo">
      <img src="{{ '/assets/img/selfie.jpg' | relative_url }}" alt="Wenhao Lu">
    </div>
    <div class="hero-info">
      <div class="hero-role">
        <span class="dot"></span>
        AI SAFETY RESEARCHER <span class="dot"></span> BUILDER
      </div>
      <div class="hero-name">
        <span class="last">Wenhao</span>
        <span class="accent">Lu</span>
      </div>
    </div>
  </header>

  <!-- Page header -->
  <div class="page-header">
    <div>
      <span class="page-kicker">{{ page.date | date: '%b %d, %Y' }}</span>
      <h1 class="page-title">{{ page.title }}</h1>
      {% if page.description %}<p class="page-subtitle">{{ page.description }}</p>{% endif %}
    </div>
    <div class="page-aside">
      <div class="crumb"><a href="{{ '/blog/' | relative_url }}">← back to blog</a></div>
    </div>
  </div>

  <article class="post-body">
    {{ content }}
  </article>

</div>
